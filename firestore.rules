rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && (
        // Check old users collection
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true) ||
        // Check new companyUsers collection
        (exists(/databases/$(database)/documents/companyUsers/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/companyUsers/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // Helper function to check if user is super admin
    function isSuperAdmin() {
      return isAuthenticated() && (
        // Check old users collection
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true) ||
        // Check new companyUsers collection
        (exists(/databases/$(database)/documents/companyUsers/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/companyUsers/$(request.auth.uid)).data.isSuperAdmin == true)
      );
    }

    // Helper function to check if user is a company owner
    function isCompanyOwner(userId) {
      return isAuthenticated() && (
        // Check old users collection
        (exists(/databases/$(database)/documents/users/$(userId)) &&
         get(/databases/$(database)/documents/users/$(userId)).data.role == 'company_owner') ||
        // Check new companyUsers collection
        (exists(/databases/$(database)/documents/companyUsers/$(userId)) &&
         get(/databases/$(database)/documents/companyUsers/$(userId)).data.role == 'company_owner')
      );
    }

    // Helper function to check if user is a driver
    function isDriver(userId) {
      return isAuthenticated() && (
        // Check old users collection
        (exists(/databases/$(database)/documents/users/$(userId)) &&
         get(/databases/$(database)/documents/users/$(userId)).data.role == 'driver') ||
        // Check new companyUsers collection
        (exists(/databases/$(database)/documents/companyUsers/$(userId)) &&
         get(/databases/$(database)/documents/companyUsers/$(userId)).data.role == 'driver')
      );
    }

    // Helper function to check if user is part of the same company
    function isSameCompany(userId1, userId2) {
      return isAuthenticated() && (
        // Check old users collection
        (exists(/databases/$(database)/documents/users/$(userId1)) &&
         exists(/databases/$(database)/documents/users/$(userId2)) &&
         get(/databases/$(database)/documents/users/$(userId1)).data.parentCompanyId == 
         get(/databases/$(database)/documents/users/$(userId2)).data.parentCompanyId) ||
        // Check new companyUsers collection
        (exists(/databases/$(database)/documents/companyUsers/$(userId1)) &&
         exists(/databases/$(database)/documents/companyUsers/$(userId2)) &&
         get(/databases/$(database)/documents/companyUsers/$(userId1)).data.companyId == 
         get(/databases/$(database)/documents/companyUsers/$(userId2)).data.companyId)
      );
    }

    // Locations collection
    match /locations/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Shipments collection
    match /shipments/{shipmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.shipperId == request.auth.uid;
    }

    // Metrics collection
    match /metrics/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // User profiles and their subcollections
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin() || 
        // Allow company owners to update their drivers' profiles
        (isCompanyOwner(request.auth.uid) && isSameCompany(request.auth.uid, userId));
      allow delete: if isOwner(userId) || isSuperAdmin();
      
      // Partners subcollection (open to all authenticated users)
      match /partners/{partnerId} {
        allow read, create, update, delete: if isAuthenticated();
      }
    }

    // Carriers collection
    match /carriers/{carrierId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }

    // Carrier metrics collection
    match /carrier_metrics/{carrierId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        exists(/databases/$(database)/documents/carriers/$(carrierId)) &&
        get(/databases/$(database)/documents/carriers/$(carrierId)).data.userId == request.auth.uid;
    }

    // Posts
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.authorId == request.auth.uid;
    }

    // Comments
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.authorId == request.auth.uid;
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Notifications collection - FIXED FOR CARRIER REJECTION WORKFLOW
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.carrierId == request.auth.uid ||
        resource.data.shipperId == request.auth.uid ||
        // Allow carrier to update notifications they are the recipient of
        resource.data.recipientId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.carrierId == request.auth.uid ||
        resource.data.shipperId == request.auth.uid
      );
    }

    // Purchase Orders collection - FIXED FOR CARRIER REJECTION WORKFLOW
    match /purchaseOrders/{poId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        // Allow carrier to update PO status when rejecting (for business logic)
        (
          request.resource.data.status == 'Active' &&
          resource.data.userId != request.auth.uid
        )
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Loads collection - FIXED FOR CARRIER REJECTION WORKFLOW
    match /loads/{loadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.carrierId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        (
          resource.data.isMarketplace == true &&
          request.resource.data.carrierId == request.auth.uid &&
          request.resource.data.isMarketplace == false
        ) ||
        // Allow carrier to update load when rejecting (remove carrierId, change status)
        (
          resource.data.carrierId == request.auth.uid &&
          request.resource.data.carrierId == null
        )
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Partner Requests collection
    match /partnerRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.carrierId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    // Invites collection for driver invitations
    match /invites/{inviteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.inviterId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.inviterId == request.auth.uid ||
        isAdmin()
      );
    }

    // Personnel collection (admin only)
    match /personnel/{personnelId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Code Change Requests collection
    match /codeChangeRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // NEW: System collection (admin only) - FOR FEATURE FLAGS
    match /system/{documentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // Carrier Notes collection
    match /carrierNotes/{noteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Carrier Documents collection
    match /carrierDocuments/{documentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        // Allow shippers to view carrier documents if they have a partnership
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/partners/$(resource.data.userId))
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // NEW: Broker Portal Collections
    
    // User Types collection (configurable user types)
    match /userTypes/{userTypeId} {
      allow read: if isAuthenticated(); // All authenticated users can read user types
      allow write: if isAdmin();        // Only admins can modify user types
    }
    
    // Companies collection
    match /companies/{companyId} {
      allow read: if isAuthenticated(); // All authenticated users can read company info
      allow create: if isAuthenticated(); // Users can create companies
      allow update: if isAuthenticated() && (
        // Company owners can update their company
        exists(/databases/$(database)/documents/companyUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/companyUsers/$(request.auth.uid)).data.companyId == companyId &&
        get(/databases/$(database)/documents/companyUsers/$(request.auth.uid)).data.role in ['owner', 'admin']
      ) ||
        // Admins can update any company for approval purposes
        isAdmin();
      allow delete: if isAdmin(); // Only admins can delete companies
    }
    
    // Company Users collection
    match /companyUsers/{userId} {
      allow read: if isAuthenticated(); // All authenticated users can read user profiles
      allow create: if isAuthenticated() && request.auth.uid == userId; // Users can create their own profile
      allow update: if isAuthenticated() && (
        // Users can update their own profile
        request.auth.uid == userId ||
        // Company owners/admins can update users in their company
        (
          exists(/databases/$(database)/documents/companyUsers/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/companyUsers/$(request.auth.uid)).data.role in ['owner', 'admin'] &&
          get(/databases/$(database)/documents/companyUsers/$(request.auth.uid)).data.companyId == 
          get(/databases/$(database)/documents/companyUsers/$(userId)).data.companyId
        ) ||
        // Admins can update any user for approval purposes
        isAdmin()
      );
      allow delete: if isAdmin(); // Only admins can delete users
    }
    
    // Load Visibility Rules collection
    match /loadVisibilityRules/{ruleId} {
      allow read: if isAuthenticated(); // All authenticated users can read visibility rules
      allow write: if isAdmin();        // Only admins can modify visibility rules
    }
    
    // Default deny
    match /{document=**} {
      allow read: if isAuthenticated();
    }
  }
} 