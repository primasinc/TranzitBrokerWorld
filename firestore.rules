rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Locations collection
    match /locations/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Shipments collection
    match /shipments/{shipmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.shipperId == request.auth.uid;
    }

    // Metrics collection
    match /metrics/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // User profiles and their subcollections
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
      
      // Partners subcollection (open to all authenticated users)
      match /partners/{partnerId} {
        allow read, create, update, delete: if isAuthenticated();
      }
    }

    // Carriers collection
    match /carriers/{carrierId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }

    // Carrier metrics collection
    match /carrier_metrics/{carrierId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        exists(/databases/$(database)/documents/carriers/$(carrierId)) &&
        get(/databases/$(database)/documents/carriers/$(carrierId)).data.userId == request.auth.uid;
    }

    // Posts
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.authorId == request.auth.uid;
    }

    // Comments
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.authorId == request.auth.uid;
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.carrierId == request.auth.uid ||
        resource.data.shipperId == request.auth.uid // Allow PO owner to delete
      );
    }

    // Purchase Orders collection
    match /purchaseOrders/{poId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Loads collection
    match /loads/{loadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.carrierId == request.auth.uid ||
        resource.data.userId == request.auth.uid // Allow PO owner to delete
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 