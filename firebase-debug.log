[debug] [2025-05-17T20:16:56.489Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/tranzitti-90210/rulesets {"name":"projects/tranzitti-90210/rulesets/f193740d-d456-4924-b05f-153a1b1f4281","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    // Helper function to check if user is authenticated\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    // Helper function to check if user is accessing their own data\r\n    function isOwner(userId) {\r\n      return isAuthenticated() && request.auth.uid == userId;\r\n    }\r\n\r\n    // Locations collection\r\n    match /locations/{userId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isOwner(userId);\r\n    }\r\n\r\n    // Shipments collection\r\n    match /shipments/{shipmentId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isAuthenticated();\r\n      allow update, delete: if isAuthenticated() && \r\n        resource.data.shipperId == request.auth.uid;\r\n    }\r\n\r\n    // Metrics collection\r\n    match /metrics/{userId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isOwner(userId);\r\n    }\r\n\r\n    // User profiles and their subcollections\r\n    match /users/{userId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isOwner(userId);\r\n      \r\n      // Partners subcollection (open to all authenticated users)\r\n      match /partners/{partnerId} {\r\n        allow read, create, update, delete: if isAuthenticated();\r\n      }\r\n    }\r\n\r\n    // Carriers collection\r\n    match /carriers/{carrierId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isAuthenticated();\r\n      allow update, delete: if isAuthenticated() && \r\n        resource.data.userId == request.auth.uid;\r\n    }\r\n\r\n    // Carrier metrics collection\r\n    match /carrier_metrics/{carrierId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isAuthenticated() && \r\n        exists(/databases/$(database)/documents/carriers/$(carrierId)) &&\r\n        get(/databases/$(database)/documents/carriers/$(carrierId)).data.userId == request.auth.uid;\r\n    }\r\n\r\n    // Posts\r\n    match /posts/{postId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isAuthenticated();\r\n      allow update, delete: if isAuthenticated() && \r\n        resource.data.authorId == request.auth.uid;\r\n    }\r\n\r\n    // Comments\r\n    match /comments/{commentId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isAuthenticated();\r\n      allow update, delete: if isAuthenticated() && \r\n        resource.data.authorId == request.auth.uid;\r\n    }\r\n\r\n    // Default deny\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n} ","name":"firestore.rules"}]},"createTime":"2025-05-17T20:16:56.417007Z","metadata":{"services":["cloud.firestore"]}}
