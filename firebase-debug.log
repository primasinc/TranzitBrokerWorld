[debug] [2025-05-17T20:16:55.748Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/tranzitti-90210/rulesets {"name":"projects/tranzitti-90210/rulesets/d9e985ef-2940-49a3-97d5-c4b142b25f61","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice firebase.storage {\r\n  match /b/{bucket}/o {\r\n    // Helper function to check if user is authenticated\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    // Helper function to check if user is accessing their own files\r\n    function isOwner(userId) {\r\n      return isAuthenticated() && request.auth.uid == userId;\r\n    }\r\n\r\n    // User profile images\r\n    match /users/{userId}/profile/{fileName} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isOwner(userId) \r\n        && request.resource.size < 5 * 1024 * 1024 // 5MB\r\n        && request.resource.contentType.matches('image/.*');\r\n    }\r\n\r\n    // Load documents and images\r\n    match /loads/{loadId}/{fileName} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isAuthenticated()\r\n        && request.resource.size < 15 * 1024 * 1024 // 15MB\r\n        && (\r\n          request.resource.contentType.matches('image/.*') ||\r\n          request.resource.contentType.matches('application/pdf')\r\n        );\r\n      allow delete: if isAuthenticated() && \r\n        request.auth.uid == resource.metadata.uploaderId;\r\n    }\r\n\r\n    // Default deny\r\n    match /{allPaths=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n} ","name":"storage.rules"}]},"createTime":"2025-05-17T20:16:55.686623Z","metadata":{"services":["firebase.storage"]}}
